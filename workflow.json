        "jsCode": "const lead = $('Validate + Normalize').first().json;\n\nlet score = 0;\nconst reasons = [];\n\nconst highUrgency = ['high', 'urgent', 'asap', 'sofort', 'dringend'];\nif (highUrgency.includes(lead.urgency)) {\n  score += 3;\n  reasons.push(`urgency=${lead.urgency}`);\n}\n\nif (typeof lead.budget === 'number' && lead.budget >= 5000) {\n  score += 2;\n  reasons.push(`budget>=5000 (${lead.budget})`);\n}\n\nconst text = `${lead.message} ${lead.company}`.toLowerCase();\nconst highIntentTerms = [\n  'angebot', 'proposal', 'demo', 'termin', 'meeting',\n  'call', 'diese woche', 'this week', 'urgent', 'asap'\n];\n\nconst matchedTerms = highIntentTerms.filter(term => text.includes(term));\nif (matchedTerms.length > 0) {\n  score += 2;\n  reasons.push(`high-intent=${matchedTerms.join(',')}`);\n}\n\nconst priority = score >= 3 ? 'HIGH' : 'NORMAL';\nconst routedTo = priority === 'HIGH' ? '#priority' : '#leads';\n\nconst discordMessage = [\n  priority === 'HIGH' ? '**HIGH PRIORITY LEAD**' : '**New Lead**',\n  `ID: ${lead.leadId}`,\n  `Name: ${lead.name}`,\n  `Email: ${lead.email}`,\n  lead.phone ? `Phone: ${lead.phone}` : null,\n  lead.company ? `Company: ${lead.company}` : null,\n  `Source: ${lead.source}`,\n  lead.budget !== null ? `Budget: ${lead.budget}` : null,\n  lead.urgency ? `Urgency: ${lead.urgency}` : null,\n  `Priority score: ${score}`,\n  reasons.length ? `Reasons: ${reasons.join(' | ')}` : null,\n  '',\n  `Message: ${lead.message}`\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    ...lead,\n    priority,\n    priorityScore: score,\n    priorityReasons: reasons,\n    routedTo,\n    discordMessage\n  }\n}];"
      },
